<?php

/**
 * @file
 * Theme functions for the MSPP theme.
 */

/**
 * Implements hook_preprocess_page().
 */
function mspp_preprocess_page(array &$variables) {
  // Get the current route match
  $route_match = \Drupal::routeMatch();

  // Try to get the title from the route
  $route = $route_match->getRouteObject();
  if ($route) {
    $title = \Drupal::service('title_resolver')
      ->getTitle(\Drupal::request(), $route);
    
    // Convert render arrays to strings
    if (is_array($title)) {
      $variables['title'] = \Drupal::service('renderer')->render($title);
    }
    // Convert markup objects to strings
    elseif ($title instanceof \Drupal\Component\Render\MarkupInterface) {
      $variables['title'] = $title->__toString();
    }
    else {
      $variables['title'] = $title;
    }
  }

  // Special handling for node pages
  if ($node = $route_match->getParameter('node')) {
    if ($node instanceof \Drupal\node\NodeInterface) {
      $variables['title'] = $node->getTitle();
    }
  }

  // Special handling for taxonomy term pages
  if ($term = $route_match->getParameter('taxonomy_term')) {
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $variables['title'] = $term->getName();
    }
  }

  // Fallback if no title is set
  if (empty($variables['title'])) {
    $variables['title'] = \Drupal::config('system.site')->get('name');
  }

  // Ensure footer region always renders by adding a placeholder if empty
  if (empty($variables['page']['footer'])) {
    $variables['page']['footer'] = [
      '#markup' => '',
      '#cache' => [
        'contexts' => ['url.path'],
      ],
    ];
  }

  // Attach contact page library for contact route
  $current_route = $route_match->getRouteName();
  if ($current_route === 'contact.site_page' || $current_route === 'entity.contact_form.canonical') {
    $variables['#attached']['library'][] = 'mspp/contact-page';
  }
}

/**
 * Implements hook_preprocess_html().
 */
function mspp_preprocess_html(array &$variables) {
  // Check if we're on the front page
  $is_front = \Drupal::service('path.matcher')->isFrontPage();
  
  if ($is_front) {
    // Get the base URL
    $base_url = \Drupal::request()->getSchemeAndHttpHost();
    $theme_path = $base_url . '/' . \Drupal::service('extension.list.theme')->getPath('mspp');
    
    // Add Open Graph meta tags for homepage
    $og_tags = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'property' => 'og:title',
          'content' => 'Site officiel du Ministère de la Santé Publique et de la Population (MSPP)',
        ],
      ],
      [
        '#tag' => 'meta',
        '#attributes' => [
          'property' => 'og:description',
          'content' => 'Retrouvez les informations sanitaires, les services aux citoyens, les communiqués officiels, les campagnes de prévention et les ressources essentielles pour la population haïtienne.',
        ],
      ],
      [
        '#tag' => 'meta',
        '#attributes' => [
          'property' => 'og:image',
          'content' => $theme_path . '/images/og-image.jpg',
        ],
      ],
      [
        '#tag' => 'meta',
        '#attributes' => [
          'property' => 'og:url',
          'content' => $base_url,
        ],
      ],
      [
        '#tag' => 'meta',
        '#attributes' => [
          'property' => 'og:type',
          'content' => 'website',
        ],
      ],
    ];
    
    // Attach meta tags to page head
    foreach ($og_tags as $key => $tag) {
      $variables['page']['#attached']['html_head'][] = [$tag, 'og_tag_' . $key];
    }
  }
}

