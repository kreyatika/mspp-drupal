<div class="container">
    <div class="row">
        <div class="col-lg-10">
            <div class="row">
                <div class="col-md-12">
                    <div class="card shadow-sm mb-5 border-0">
                        <div class="card-body">
                            <form method="post" action="{{ path('result.exam_result') }}">
                                {% if not result %}

                                    <div class="mb-5">
                                        <p>
                                            Consultez en ligne les résultats officiels des examens du Ministère de la Santé Publique et de la Population (MSPP).
                                            Renseignez votre numéro d’ordre, votre catégorie et la session correspondante.
                                        </p>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group mb-4">
                                                <label for="category" class="form-label fw-bold">{{ 'Catégorie'|t }}</label>
                                                <div class="input-group input-group-lg">
                                                    <span class="input-group-text bg-light">
                                                        <i class="fas fa-graduation-cap"></i>
                                                    </span>
                                                    <select class="form-select" id="category" name="category" required>
                                                        <option value="">{{ 'Choisir une catégorie'|t }}</option>
                                                        {% if categories %}
                                                            {% for category in categories %}
                                                                <option value="{{ category.id }}">{{ category.name }}</option>
                                                            {% endfor %}
                                                        {% endif %}
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-4">
                                                <label for="session" class="form-label fw-bold">{{ 'Session'|t }}</label>
                                                <div class="input-group input-group-lg">
                                                    <span class="input-group-text bg-light">
                                                        <i class="fas fa-calendar-alt"></i>
                                                    </span>
                                                    <select class="form-select" id="session" name="session" required>
                                                        <option value="">{{ 'Choisir une session'|t }}</option>
                                                        {% if sessions %}
                                                            {% for session in sessions %}
                                                                <option value="{{ session.id }}">{{ session.date }}</option>
                                                            {% endfor %}
                                                        {% endif %}
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group mb-4">
                                            <label for="numero_ordre" class="form-label fw-bold">{{ 'Numéro d\'ordre'|t }}</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text bg-light">
                                                <i class="fas fa-id-card"></i>
                                            </span>
                                            <input type="text" 
                                                   class="form-control" 
                                                   id="numero_ordre" 
                                                   name="numero_ordre" 
                                                   placeholder="Ex: OAP001" 
                                                   required>
                                        </div>
                                        <small class="form-text text-muted">{{ 'Le numéro d’ordre figure sur votre carte de candidat.'|t }}</small>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fas fa-search me-2"></i>{{ 'Consulter mes résultats'|t }}
                                        </button>
                                    </div>
                                {% endif %}

                                {% if result %}
                                    <div class="mt-4">
                                        <div class="table-responsive">
                                            <table class="table table-bordered">
                                                <tbody>
                                                    <tr>
                                                        <th class="bg-light">Nom de famille</th>
                                                        <td>{{ result.last_name }}</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">Prénom</th>
                                                        <td>{{ result.first_name }}</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">Date de naissance</th>
                                                        <td>{{ result.birth_date|date('d/m/Y') }}</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">NINU</th>
                                                        <td>{{ result.ninu }}</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">Numéro d'ordre</th>
                                                        <td>{{ result.order_number }}</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Établissement de formation</th>
                                            <td>{{ result.school }}</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Catégorie</th>
                                            <td>{{ result.category.name }}</td>
                                        </tr>

                                        <tr>
                                            <th class="bg-light">Session d’examen</th>
                                            <td>{{ result.session.date }}</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Résultat</th>
                                            <td>
                                                {% if result.passed == 'REUSSITE' %}
                                                    <span class="badge bg-success text-uppercase">REUSSITE</span>
                                                {% elseif result.passed == 'ECHEC' %}
                                                    <span class="badge bg-danger text-uppercase">ECHEC</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a href="{{ path('result.exam_result') }}" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-search me-2"></i>
                                {{ 'Nouvelle recherche'|t }}
                            </a>
                            <a href="{{ path('<front>') }}" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-home me-2"></i>
                                {{ 'Retour à l\'accueil'|t }}
                                        </a>
                                    </div>
                                {% endif %}
                            </form>

                            {% if error_message %}
                                <div class="alert alert-danger mt-4" role="alert">
                                    <i class="fas fa-exclamation-circle me-2"></i>{{ error_message }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card border-0 bg-light rounded-3 mb-4">
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold mb-3">
                                <i class="fas fa-info-circle text-primary me-2"></i>{{ 'Important'|t }}
                            </h5>
                            <p class="card-text">{{ 'Cette plateforme est destinée exclusivement aux candidates et candidats inscrits aux examens officiels du Ministère de la Santé Publique et de la Population (MSPP).'|t }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 bg-light rounded-3">
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold mb-3">
                                <i class="fas fa-headset text-primary me-2"></i>{{ 'Besoin d\'aide ?'|t }}
                            </h5>
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="fas fa-envelope text-muted me-2"></i>
                                    dfpss@mspp.gouv.ht
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-phone text-muted me-2"></i>
                                    (+509) 2234-5678
                                </li>
                                <li>
                                    <i class="fas fa-clock text-muted me-2"></i>
                                    {{ 'Lun-Ven, 8h AM - 4h PM'|t }}
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

